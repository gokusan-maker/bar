# --- 必須（本番） ---
# アプリの公開URL（末尾スラッシュなし）。Google連携のリダイレクト先とカレンダーのリンクに使う
APP_BASE_URL=https://your-bar.vercel.app
# 管理画面のパスワードと、ログイン情報の署名用ランダム文字列
ADMIN_PASSWORD=
SESSION_SECRET=
# スタッフ用パスワード（任意）。予約の閲覧と来店チェックだけできる
STAFF_PASSWORD=

# --- データベース（Supabase）。未設定ならメモリ保存（開発用） ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Googleのトークンを暗号化する鍵（ランダムな長い文字列）
TOKEN_ENCRYPTION_KEY=

# --- メッセージの読み取り（Claude API）。未設定なら簡易ルールで読み取り ---
ANTHROPIC_API_KEY=

# --- LINE公式アカウント（Messaging API） ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 店主への通知先（店主がこの公式アカウントを友だち追加したときのユーザーID）
OWNER_LINE_USER_ID=

# --- Instagram（Instagramログイン方式のAPI） ---
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
# Webhook登録時に自分で決める確認用文字列
INSTAGRAM_VERIFY_TOKEN=
# INSTAGRAM_API_BASE=https://graph.instagram.com/v23.0

# --- Googleカレンダー（Google Cloud の OAuth クライアント） ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- リマインド（Vercel Cron が自動で付与する） ---
CRON_SECRET=
