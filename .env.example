# --- 必須（本番） ---
# アプリの公開URL（末尾スラッシュなし）。Google連携のリダイレクト先とカレンダーのリンクに使う
APP_BASE_URL=https://bar.your-subdomain.workers.dev
# ログイン情報の署名用ランダム文字列（必須）
SESSION_SECRET=
# 店舗1（1店舗だったころからのお店）のオーナーのパスワード（任意。新しいお店のオーナーは /signup で自分のIDとパスワードを作る）
ADMIN_PASSWORD=
# 新しいお店の登録（/signup）に必要な登録コード（任意。決めると、コードを知っている人だけが登録できる）
SIGNUP_CODE=
# 運営の画面（/operator）のパスワード（任意。登録されたお店の一覧・利用の停止）
OPERATOR_PASSWORD=
# スタッフ共通のパスワード（任意）。スタッフはそれぞれ自分のLINE・パスワードでもログインできる
STAFF_PASSWORD=

# --- データベース（Supabase）。未設定ならメモリ保存（開発用） ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Googleのトークンを暗号化する鍵（ランダムな長い文字列）
TOKEN_ENCRYPTION_KEY=

# --- メッセージの読み取り（Claude API）。未設定なら簡易ルールで読み取り ---
ANTHROPIC_API_KEY=

# --- LINE公式アカウント（Messaging API）。店舗1だけの設定。ほかのお店は「設定 → SNSの接続」で入れる ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 店主への通知先（店主がこの公式アカウントを友だち追加したときのユーザーID）
OWNER_LINE_USER_ID=

# --- LINEでログイン（LINEログインチャネル。Messaging APIと同じプロバイダーに作る） ---
# コールバックURL: <APP_BASE_URL>/api/line-login/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# --- Instagram（Instagramログイン方式のAPI）。店舗1だけの設定。ほかのお店は「設定 → SNSの接続」で入れる ---
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
# Webhook登録時に自分で決める確認用文字列
INSTAGRAM_VERIFY_TOKEN=
# INSTAGRAM_API_BASE=https://graph.instagram.com/v23.0

# --- Googleカレンダー（Google Cloud の OAuth クライアント） ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 定期処理（リマインド・17時の通知など）の合言葉。長いランダムな文字列 ---
CRON_SECRET=
